# ==========================================
# BANIT GÜVENLİK VE AYAR DOSYASI ŞABLONU
# ==========================================

# 1. Kontrol Paneli (Dashboard) Giriş Bilgileri
# Arayüze girerken kullanacağınız kendi belirlediğiniz kullanıcı adı ve şifre
ADMIN_USERNAME=admin
ADMIN_PASSWORD=buraya_kendi_guvenli_sifrenizi_yazin

# 2. JWT (Kimlik Doğrulama) Güvenlik Ayarları
# SECRET_KEY paneli koruyan gizli anahtardır. 
# (Linux terminalinde 'openssl rand -hex 32' yazarak rastgele bir tane üretebilirsiniz)
SECRET_KEY=buraya_rastgele_karmasik_bir_metin_yazin_ornek_a1b2c3d4...
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440